{
  "kind": "collectionType",
  "collectionName": "images",
  "info": {
    "singularName": "image",
    "pluralName": "images",
    "displayName": "Image",
    "description": "An image with its source and licence, both required (concept public-content.md §8, PUB-F-13)"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "file": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "alternativeText": {
      "type": "string",
      "maxLength": 200,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "source": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 300,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "licence": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 100,
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
