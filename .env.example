# Copy to .env and replace the values. Never commit .env.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=stash
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# MongoDB (docker-compose.yml)
MONGO_USER=stash
MONGO_PASSWORD=change-me

# Web application (apps/web). Also put this line into apps/web/.env, the web
# application reads it from there. Keep user and password equal to the
# PostgreSQL values above and the database name equal to POSTGRES_DB in
# docker-compose.yml.
DATABASE_URL=postgresql://stash:change-me@localhost:5432/stash_db
