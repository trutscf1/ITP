# Copy to .env and replace the values. Never commit .env.
# Every setting of the local stack (docker-compose.yml) comes from here (SCF-AC-2.2).
# The token of the code quality scan (pnpm sonar) lives in .env.sonar instead (.env.sonar.example).

# Reverse proxy (published on this host port), web, and identity (internal ports)
PROXY_PORT=8080
WEB_PORT=3000
IDENTITY_PORT=3001
# web reads the variables below (M1 of gam-ai-knowledge/concepts/scaffolding.track-web.md). A missing
# or empty one takes the default shown; set one only to change it. Inside the stack,
# docker-compose.yml sets PORT from WEB_PORT.
# PORT=3000
# APP_VERSION=0.0.0-dev
# HEALTH_TIMEOUT_MS=2000
# IDENTITY_HEALTH_URL=http://identity:3001/health
# STORAGE_HEALTH_URL=http://storage:3002/health
# WORKER_HEALTH_URL=http://worker:3003/health
# CMS_HEALTH_URL=http://cms:1337/health
# web serves the API description at /api/docs from OPENAPI_FILE. Its default is the file that the
# build of packages/contracts writes, relative to apps/web; set it only if the file lives elsewhere:
# OPENAPI_FILE=../../packages/contracts/dist/openapi.json

# PostgreSQL
POSTGRES_DB=stash_db
POSTGRES_USER=stash
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# DATABASE_URL is built from the four values above: inside the stack by docker-compose.yml with
# the host postgres, outside containers by packages/db (`pnpm db:migrate`, `pnpm db:seed`) with
# the host localhost. Set it only to reach another database.
# DATABASE_URL=postgresql://stash:change-me@localhost:5432/stash_db
# The database tests (pnpm test) run only when TEST_DATABASE_URL is set; each test creates and
# drops its own database there, so point it at a server you can throw data at, never at stash_db.
# CI sets it for its PostgreSQL service.
# TEST_DATABASE_URL=postgresql://stash:change-me@localhost:5432/stash_test
# The tests of identity also need a Redis: set TEST_REDIS_URL, otherwise they are skipped. They use
# keys per client address and leave them to expire, but point it at a Redis you can throw data
# at, never at the one of the local stack. CI sets it for its Redis service.
# TEST_REDIS_URL=redis://localhost:6379

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# MongoDB
MONGO_USER=stash
MONGO_PASSWORD=change-me
MONGO_PORT=27017

# CouchDB
COUCHDB_USER=stash
COUCHDB_PASSWORD=change-me
COUCHDB_PORT=5984

# SeaweedFS (S3 interface, published on this host port)
SEAWEEDFS_S3_PORT=8333

# ClamAV: "true" starts offline with the definitions of the image, "false" updates them
CLAMAV_NO_FRESHCLAMD=true

# Services on the internet are off, so the stack starts without internet access (SCF-AC-2.3).
# Outgoing e-mail goes to Mailpit; its inbox is published on this host port.
OAUTH_ENABLED=false
CAPTCHA_ENABLED=false
MAILPIT_UI_PORT=8025

# identity (concepts/identity.md §8, "Configuration of `identity`"). Inside the stack,
# docker-compose.yml builds REDIS_URL from REDIS_PASSWORD, DATABASE_URL from the PostgreSQL values,
# and sends e-mail to mailpit; the bot check (CAPTCHA_ENABLED above) is off, so the two keys stay
# placeholders until it is switched on. The secret signs the library's tokens: at least 32
# characters, and replace it everywhere but on your own machine.
PUBLIC_ORIGIN=http://localhost:8080
IDENTITY_AUTH_SECRET=change-me-change-me-change-me-change-me
REGISTRATION_ENABLED=true
CONFIRMATION_LINK_TTL_HOURS=24
UNCONFIRMED_ACCOUNT_TTL_DAYS=7
RESET_LINK_TTL_MINUTES=30
SESSION_TTL_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=60
LOGIN_LOCK_MINUTES=15
REQUEST_LIMIT_PER_MINUTE=5
CAPTCHA_SITE_KEY=change-me
CAPTCHA_SECRET_KEY=change-me
SMTP_FROM=no-reply@stash.local
SESSION_CHECK_TIMEOUT_MS=1000
# identity also reads the variables below; REDIS_URL has no default, the others take the default shown
# when missing or empty. Inside the stack, docker-compose.yml builds REDIS_URL from REDIS_PASSWORD,
# sets PORT from IDENTITY_PORT, fixes SMTP_HOST and SMTP_PORT to the mail catcher, and TRUSTED_PROXY to
# the reverse proxy `proxy`, the only peer whose X-Forwarded-For counts (Q352); set them only
# to run identity outside the stack (`pnpm --filter @stash/identity dev`).
# REDIS_URL=redis://:change-me@localhost:6379
# PORT=3001
# APP_VERSION=0.0.0-dev
# HEALTH_CHECK_TIMEOUT_MS=1000
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# TRUSTED_PROXY=proxy
# Observability stack (OBS-F-5, documentation/concepts/observability.md §8). The profile starts the
# collector, the metric, log, and trace stores, and the dashboard tool with `docker compose up`;
# remove the profile from the next line to start without them. None of the values is a secret.
COMPOSE_PROFILES=observability
# Days the metric, log, and trace stores keep their data (1 to 90, 1 to 30, 1 to 30).
OBS_METRICS_RETENTION_DAYS=15
OBS_LOGS_RETENTION_DAYS=7
OBS_TRACES_RETENTION_DAYS=7
# Alert thresholds (OBS-US-2): error rate in percent (0.1 to 100) and the least number of requests
# in 5 minutes before it counts, storage usage in percent (1 to 100), the least number of waiting
# jobs (1 to 1000000), and the minutes of silence of a unit (1 to 60).
OBS_ALERT_ERROR_RATE_PERCENT=5
OBS_ALERT_MIN_REQUESTS=20
OBS_ALERT_STORAGE_PERCENT=90
OBS_ALERT_QUEUE_MIN_WAITING=10
OBS_ALERT_SILENT_MINUTES=2
# Host port of the dashboard tool, bound to 127.0.0.1 until TLS exists (1024 to 65535).
OBS_DASHBOARD_PORT=3300

# Telemetry of every unit (OBS-F-1, section 8 of gam-ai-knowledge/concepts/observability.md); each unit reads these, an empty value takes the default.
# Switch telemetry on or off (true or false).
TELEMETRY_ENABLED=true
# OTLP/HTTP endpoint of the collector (http or https URL).
TELEMETRY_ENDPOINT=http://collector:4318
# Export interval in milliseconds (1000 to 60000).
TELEMETRY_EXPORT_INTERVAL_MS=15000
# Share of traces that are kept (decimal from 0.0 to 1.0).
TELEMETRY_TRACE_SAMPLE_RATIO=1
# Entries a unit buffers while the collector is unreachable (100 to 100000).
TELEMETRY_BUFFER_LIMIT=2048
# Log level of the units (debug, info, warn, error).
LOG_LEVEL=info
