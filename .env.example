# Copy to .env and replace the values. Never commit .env.
# Every setting of the local stack (docker-compose.yml) comes from here (SCF-AC-2.2).
# The token of the code quality scan (pnpm sonar) lives in .env.sonar instead (.env.sonar.example).

# Reverse proxy (published on this host port) and web (internal port)
PROXY_PORT=8080
WEB_PORT=3000
# web reads the variables below (M1 of documentation/concepts/scaffolding.track-web.md). A missing
# or empty one takes the default shown; set one only to change it. Inside the stack,
# docker-compose.yml sets PORT from WEB_PORT.
# PORT=3000
# APP_VERSION=0.0.0-dev
# HEALTH_TIMEOUT_MS=2000
# IDENTITY_HEALTH_URL=http://identity:3001/health
# STORAGE_HEALTH_URL=http://storage:3002/health
# WORKER_HEALTH_URL=http://worker:3003/health
# CMS_HEALTH_URL=http://cms:1337/health
# web serves the API description at /api/docs from OPENAPI_FILE. Its default is the file that the
# build of packages/contracts writes, relative to apps/web; set it only if the file lives elsewhere:
# OPENAPI_FILE=../../packages/contracts/dist/openapi.json

# PostgreSQL
POSTGRES_DB=stash_db
POSTGRES_USER=stash
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# DATABASE_URL is built from the four values above: inside the stack by docker-compose.yml with
# the host postgres, outside containers by packages/db (`pnpm db:migrate`, `pnpm db:seed`) with
# the host localhost. Set it only to reach another database.
# DATABASE_URL=postgresql://stash:change-me@localhost:5432/stash_db
# The database tests (pnpm test) run only when TEST_DATABASE_URL is set; each test creates and
# drops its own database there, so point it at a server you can throw data at, never at stash_db.
# CI sets it for its PostgreSQL service.
# TEST_DATABASE_URL=postgresql://stash:change-me@localhost:5432/stash_test

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# MongoDB
MONGO_USER=stash
MONGO_PASSWORD=change-me
MONGO_PORT=27017

# CouchDB
COUCHDB_USER=stash
COUCHDB_PASSWORD=change-me
COUCHDB_PORT=5984

# SeaweedFS (S3 interface, published on this host port)
SEAWEEDFS_S3_PORT=8333

# ClamAV: "true" starts offline with the definitions of the image, "false" updates them
CLAMAV_NO_FRESHCLAMD=true

# Services on the internet are off, so the stack starts without internet access (SCF-AC-2.3).
# Outgoing e-mail goes to Mailpit; its inbox is published on this host port.
OAUTH_ENABLED=false
CAPTCHA_ENABLED=false
MAILPIT_UI_PORT=8025
