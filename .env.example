# Copy to .env and replace the values. Never commit .env.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=stash
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# MongoDB (docker-compose.yml)
MONGO_USER=stash
MONGO_PASSWORD=change-me

# Relational schema (packages/db): `pnpm db:migrate` and `pnpm db:seed` against the database of
# docker-compose.yml. The database tests read TEST_DATABASE_URL from the environment only.
DATABASE_URL=postgresql://stash:change-me@localhost:5432/stash_db
