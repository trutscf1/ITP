{
  "model": "haiku",
  "plansDirectory": "./gam-ai-memory/plans",
  "attribution": {
    "pr": ""
  },
  "env": {
    "GAM_ENGINEERING_BRANCHES": "dev",
    "GAM_ENGINEERING_FLOW": "full",
    "GAM_ENGINEERING_MERGE": "ask",
    "GAM_ENGINEERING_APPROVALS": "1",
    "GAM_ENGINEERING_RELEASE_MERGE": "ask",
    "GAM_ENGINEERING_MODEL_JUDGE": "opus",
    "GAM_ENGINEERING_MODEL_DRAFT": "sonnet",
    "GAM_ENGINEERING_MODEL_CHECK": "haiku",
    "GAM_ENGINEERING_SESSION_THRESHOLD": "50",
    "GAM_ENGINEERING_DELEGATE_MIN_FILES": "5",
    "GAM_ENGINEERING_DELEGATE_MIN_OUTPUT_LINES": "200",
    "GAM_ENGINEERING_PROJECT_KIND": "student",
    "GAM_ENGINEERING_PROMPT_EXPORT": "commit",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "GAM_ENGINEERING_LIMIT_GUARD": "on",
    "GAM_ENGINEERING_LIMIT_WARN": "90",
    "GAM_ENGINEERING_LIMIT_STOP": "95",
    "GAM_ENGINEERING_LIMIT_ACTION": "auto",
    "GAM_ENGINEERING_SESSION_MAX_HOURS": "4",
    "GAM_ENGINEERING_RUNNER": "agent",
    "GAM_ENGINEERING_FRONTEND_HOOK": "off",
    "GAM_ENGINEERING_SKILL_TRIM": "on",
    "GAM_ENGINEERING_SKILLS_KEEP": ""
  },
  "permissions": {
    "ask": [
      "Bash(git merge *)",
      "Bash(glab mr merge *)",
      "Bash(gh pr merge *)",
      "PowerShell(git merge *)",
      "PowerShell(glab mr merge *)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/gam-engineering/tools/limit-statusline.mjs\""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/gam-engineering/tools/skill-trim.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/gam-engineering/tools/status-reminder.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/gam-engineering/tools/open-work-reminder.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/gam-engineering/tools/compact-hint.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/gam-engineering/tools/inbox-names.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/gam-engineering/tools/format-on-write.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/gam-engineering/tools/frontend-hook.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/gam-engineering/tools/limit-guard.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/gam-engineering/tools/limit-guard.mjs\""
          }
        ]
      }
    ]
  }
}
