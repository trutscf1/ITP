    "depth": 3,
    "skipFolders": [
      ".git",
      "node_modules",
      "vendor",
      ".venv",
      "venv",
      "__pycache__",
      "dist",
      "build",
      "target",
      "bin",
      "obj",
      ".next",
      ".nuxt",
      "coverage",
      "gam-engineering",
      "gam-ai-knowledge",
      "gam-ai-memory"
    ],
    "integration": [
      "*.bats",
      "tests/integration",
      "test/integration",
      "integration-tests",
      "tests/ops",
      "ops/tests"
    ],
    "stackLint": [
      "compose.yaml",
      "compose.yml",
      "compose.*.yaml",
      "compose.*.yml",
      "docker-compose*.yaml",
      "docker-compose*.yml",
      "*.tf",
      "Caddyfile",
      "nginx.conf",
      "*.nginx.conf",
      "traefik*.yaml",
      "traefik*.yml",
      "Chart.yaml",
      "kustomization.yaml"
    ],
    "dockerfiles": [
      "Dockerfile",
      "Dockerfile.*",
      "*.Dockerfile"
    ],
    "overlapTools": [
      "biome",
      "eslint",
      "prettier",
      "oxlint",
      "pint",
      "php-cs-fixer",
      "phpcs",
      "phpstan",
      "psalm",
      "phpunit",
      "pest",
      "vitest",
      "jest",
      "mocha",
      "pytest",
      "ruff",
      "flake8",
      "mypy",
      "black",
      "tsc",
      "vue-tsc",
      "playwright",
      "cypress",
      "bats",
      "hadolint",
      "shellcheck",
      "kubeconform",
      "tflint",
      "trivy",
      "semgrep",
      "gitleaks",
      "sonar-scanner",
      "sonarqube",
      "dependency-cruiser",
      "doc-check",
      "golangci-lint",
      "clippy",
      "rubocop",
      "rspec"
    ]
