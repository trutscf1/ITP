{
  "version": 1,
  "thresholds": [
    "low",
    "medium",
    "high",
    "critical"
  ],
  "codeExtensions": [".ps1", ".psm1", ".py", ".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx", ".sh", ".bash", ".cmd", ".bat", ".php", ".java", ".kt", ".cs", ".go", ".rs", ".rb", ".sql", ".vue", ".svelte", ".mts", ".cts", ".kts", ".dart", ".swift"],
  "docsOnly": {
    "kinds": ["docs", "secrets", "audit"],
    "documentPaths": ["*.md", "gam-ai-knowledge/", "gam-ai-memory/"],
    "stackFiles": ["pipeline.json", "package.json", "package-lock.json", "pnpm-lock.yaml", "yarn.lock", "composer.json", "composer.lock", "pyproject.toml", "requirements*.txt", "Cargo.toml", "go.mod", "pom.xml", "*.csproj", "*.sln", "compose*.y*ml", "docker-compose*.y*ml", "Dockerfile*", ".gitlab-ci.yml", ".gitlab/ci/", ".github/workflows/", ".gitleaks.toml", ".markdownlint*", "biome.json*", "tsconfig*.json", "sonar-project.properties"],
    "dataFolders": ["test-data/", "testdata/", "fixtures/", "__fixtures__/", "golden/", "snapshots/", "tests/", "test/"]
  },
  "hostTiers": {
    "gitlab": [
      "Free",
      "Premium",
      "Ultimate"
    ],
    "github": [
      "Free",
      "Team",
      "Enterprise"
    ]
  },
