  "checks": [
    {
      "kind": "audit",
      "language": "",
      "tier": "merge",
      "tool": "trivy",
      "version": "0.58.1",
      "localCalls": [
        [
          "trivy",
          "fs",
          "--scanners",
          "vuln",
          "--severity",
          "{threshold}",
          "--exit-code",
          "1",
          "."
        ]
      ],
      "needsContainer": false,
      "installHint": "Install trivy 0.58.1: https://github.com/aquasecurity/trivy/releases/tag/v0.58.1",
      "recommended": true,
      "defaultThreshold": "high",
      "ciJob": {
        "gitlab": {
          "image": "aquasec/trivy:0.58.1",
          "variables": {},
          "setup": [],
          "script": [
            "trivy fs --scanners vuln --severity {threshold} --exit-code 1 ."
          ],
          "sastReport": ""
        },
        "github": {
          "image": "aquasec/trivy:0.58.1",
          "variables": {},
          "setup": [],
          "script": [
            "trivy fs --scanners vuln --severity {threshold} --exit-code 1 ."
          ],
          "sastReport": ""
        }
      },
      "native": [],
      "yieldsTo": [
        {
          "kind": "audit",
          "language": "*"
        }
      ]
    },
    {
      "kind": "secrets",
      "language": "",
      "tier": "merge",
      "tool": "gitleaks",
      "version": "8.21.2",
      "localCalls": [
        [
          "gitleaks",
          "git",
          ".",
          "--redact"
        ],
        [
          "gitleaks",
          "dir",
          ".",
          "--redact"
        ]
      ],
      "needsContainer": false,
      "installHint": "Install gitleaks 8.21.2: https://github.com/gitleaks/gitleaks/releases/tag/v8.21.2",
      "recommended": true,
      "defaultThreshold": "",
      "ciJob": {
        "gitlab": {
          "image": "ghcr.io/gitleaks/gitleaks:v8.21.2",
          "variables": {
            "GIT_DEPTH": "0"
          },
          "setup": [
            "git config --global --add safe.directory \"$CI_PROJECT_DIR\""
          ],
          "script": [
            "gitleaks git . --redact",
            "gitleaks dir . --redact"
          ],
          "sastReport": ""
        },
        "github": {
          "image": "ghcr.io/gitleaks/gitleaks:v8.21.2",
          "variables": {},
          "setup": [
            "git config --global --add safe.directory \"$GITHUB_WORKSPACE\""
          ],
          "script": [
            "gitleaks git . --redact",
            "gitleaks dir . --redact"
          ],
          "sastReport": ""
        }
      },
      "native": []
    },
    {
      "kind": "docs",
      "language": "",
      "tier": "merge",
      "tool": "doc-check",
      "version": "",
      "localCalls": [
        [
          "node",
          "{docCheck}",
          "--status"
        ]
      ],
      "needsContainer": false,
      "installHint": "Install Node 18 or later: https://nodejs.org/",
      "recommended": true,
      "defaultThreshold": "",
      "ciJob": {
        "gitlab": {
          "image": "node:24-alpine",
          "variables": {
            "GIT_DEPTH": "0"
          },
          "setup": [
            "apk add --no-cache git",
            "git config --global --add safe.directory \"$CI_PROJECT_DIR\"",
            "git fetch --quiet --tags origin"
          ],
          "script": [
            "node {docCheck} --status --pending-title \"$CI_MERGE_REQUEST_TITLE\" --pending-branch \"$CI_MERGE_REQUEST_SOURCE_BRANCH_NAME\""
          ],
          "sastReport": ""
        },
        "github": {
          "image": "node:24",
          "variables": {
            "PR_TITLE": "${{ github.event.pull_request.title }}",
            "PR_BRANCH": "${{ github.head_ref }}"
          },
          "setup": [
            "git config --global --add safe.directory \"$GITHUB_WORKSPACE\""
          ],
          "script": [
            "node {docCheck} --status --pending-title \"$PR_TITLE\" --pending-branch \"$PR_BRANCH\""
          ],
          "sastReport": ""
        }
      },
      "native": []
    },
