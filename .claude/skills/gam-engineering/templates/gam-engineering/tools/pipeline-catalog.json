          ],
          "script": [
            "GAM_GUARD_BASE=\"origin/${CI_MERGE_REQUEST_TARGET_BRANCH_NAME:-$CI_DEFAULT_BRANCH}\" node gam-engineering/tools/floor-guard.mjs check"
          ],
          "sastReport": ""
        },
        "github": {
          "image": "node:24",
          "variables": {
            "BASE_REF": "${{ github.base_ref }}",
            "DEFAULT_BRANCH": "${{ github.event.repository.default_branch }}"
          },
          "setup": [
            "git config --global --add safe.directory \"$GITHUB_WORKSPACE\""
          ],
          "script": [
            "GAM_GUARD_BASE=\"origin/${BASE_REF:-$DEFAULT_BRANCH}\" node gam-engineering/tools/floor-guard.mjs check"
          ],
          "sastReport": ""
        }
      },
      "native": []
