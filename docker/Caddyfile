# Reverse proxy of the local stack (SCF-F-4): one origin, routed by path prefix. `web` serves
# `/`. The prefixes /api/identity, /api/storage, and /cms are added when the units run.
{
	admin off
	auto_https off
}

:80 {
	# Answered by the proxy itself, for its health check.
	handle /proxy-health {
		respond "ok" 200
	}

	# Every trace starts at the first unit: headers of the trace context that arrive from outside
	# are removed before a request is forwarded (OBS-F-16).
	request_header -traceparent
	request_header -tracestate
	request_header -baggage

	handle {
		reverse_proxy web:{$WEB_PORT}
	}
}
