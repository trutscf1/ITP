# Reverse proxy of the local stack (SCF-F-4): one origin, routed by path prefix. `web` serves
# `/`. The prefix /api/identity routes to `identity`; /api/storage and /cms are added when the
# units run.
{
	admin off
	auto_https off
}

:80 {
	# Answered by the proxy itself, for its health check.
	handle /proxy-health {
		respond "ok" 200
	}

	# Every trace starts at the first unit: headers of the trace context that arrive from outside
	# are removed before a request is forwarded (OBS-F-16).
	request_header -traceparent
	request_header -tracestate
	request_header -baggage

	# Health of the content management system (PUB-AC-1.1); the rest of /cms follows with PUB-US-1
	# slice 2.
	handle /cms/health {
		rewrite * /health
		reverse_proxy cms:1337
	}

	# `identity` (IDN-US-1): the prefix is stripped, so /api/identity/health reaches /health
	# (scaffolding.md §8, routing table).
	handle_path /api/identity/* {
		reverse_proxy identity:{$IDENTITY_PORT}
	}

	handle {
		reverse_proxy web:{$WEB_PORT}
	}
}
