# Reverse proxy of the local stack (SCF-F-4): one origin, routed by path prefix. `web` serves
# `/`. The prefix /api/identity routes to `identity`; /api/storage and /cms are added when the
# units run.
{
	admin off
	auto_https off
}

:80 {
	# Answered by the proxy itself, for its health check.
	handle /proxy-health {
		respond "ok" 200
	}

	# `identity` (IDN-US-1): the prefix is stripped, so /api/identity/health reaches /health
	# (scaffolding.md §8, routing table).
	handle_path /api/identity/* {
		reverse_proxy identity:{$IDENTITY_PORT}
	}

	handle {
		reverse_proxy web:{$WEB_PORT}
	}
}
